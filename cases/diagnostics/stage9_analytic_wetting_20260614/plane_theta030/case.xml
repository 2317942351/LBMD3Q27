<?xml version="1.0"?>
<!--
  Stage9 gate A: flat-wall regression for the analytic-geometry wetting BC.
  Status: exploratory_not_validation.

  Purpose: verify that the analytic path (AnalyticWetting=1, plane) reproduces
  the previously-passing flat-wall result to within fitting noise. On a plane
  the analytic normal equals the lattice normal, so the result should match
  the legacy flat-wall theta030 case.

  Geometry: 128 x 96 x 128 domain, FlatLowerY wall at y=0 (y is the wall
  normal). A spherical cap droplet is initialised above the wall with target
  apparent contact angle 30 deg. radAngle is zonal: OuterDomain=90d (neutral),
  FlatLowerY=30d (wetting).

  Analytic geometry: plane with axis=1 (y), offset=0.

  Run: 1000-step smoke + 200000-step long. See
  docs/stage9/analytic_wetting_bc_design_20260614.md gate A.
-->
<CLBConfig version="2.0" output="stage9/plane_theta030/output/" permissive="false">
  <Geometry nx="128" ny="96" nz="128">
    <MRT><Box/></MRT>
    <Wall mask="ALL" name="OuterDomain">
      <Box nx="1"/>
      <Box dx="-1"/>
      <Box dy="-1"/>
      <Box nz="1"/>
      <Box dz="-1"/>
    </Wall>
    <Wall mask="ALL" name="FlatLowerY">
      <Box ny="1"/>
    </Wall>
  </Geometry>
  <Model>
    <Param name="Density_h" value="1"/>
    <Param name="Density_l" value="0.001"/>
    <Param name="Viscosity_h" value="0.09"/>
    <Param name="Viscosity_l" value="0.1"/>
    <Param name="tauUpdate" value="3"/>
    <Param name="sigma" value="5e-05"/>
    <Param name="M" value="0.1"/>
    <Param name="IntWidth" value="6"/>
    <!-- Spherical-cap droplet initialiser, target apparent angle 30 deg -->
    <Param name="CapInit" value="1"/>
    <Param name="CapInitRadius" value="102.4368595766759"/>
    <Param name="CapInitTheta" value="0.5235987755982988"/>
    <Param name="CapInitCenterX" value="64"/>
    <Param name="CapInitCenterY" value="-88.71292267730063"/>
    <Param name="CapInitCenterZ" value="64"/>
    <!-- Zonal contact angles: outer walls neutral, lower wall wetting -->
    <Param name="radAngle" value="90d"/>
    <Param name="radAngle" value="90d" zone="OuterDomain"/>
    <Param name="radAngle" value="30d" zone="FlatLowerY"/>
    <!-- Stage9 analytic-geometry wetting BC: plane along y -->
    <Param name="AnalyticWetting" value="1"/>
    <Param name="AnalyticSolidType" value="1"/>
    <Param name="AnalyticSolidAxis" value="1"/>
    <Param name="AnalyticSolidPlaneOffset" value="0.0"/>
    <Param name="minGradient" value="1e-08"/>
    <Param name="VelocityX" value="0.0"/>
    <Param name="VelocityY" value="0.0"/>
    <Param name="VelocityZ" value="0.0"/>
    <Param name="GravitationX" value="0.0"/>
    <Param name="GravitationY" value="0.0"/>
    <Param name="GravitationZ" value="0.0"/>
  </Model>
  <VTK what="PhaseField,U,P,Rho,BOUNDARY,WallGhost,WallH,AnalyticWallNormal,AnalyticFlag"/>
  <Log Iterations="1000"/>
  <Failcheck Iterations="1000"/>
  <Solve Iterations="200000">
    <VTK Iterations="10000" what="PhaseField,U,P,Rho,BOUNDARY,WallGhost,WallH,AnalyticWallNormal,AnalyticFlag"/>
    <Log Iterations="1000"/>
    <Failcheck Iterations="1000"/>
  </Solve>
</CLBConfig>
