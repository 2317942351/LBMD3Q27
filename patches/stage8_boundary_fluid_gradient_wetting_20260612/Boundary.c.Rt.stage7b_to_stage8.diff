+}
+
+CudaDeviceFunction real_t getWallStage8GradWriteDeltaMag() {
+	return Stage8GradWriteDeltaMag(0,0,0);
+}
+
+CudaDeviceFunction real_t getWallStage8LimiterReason() {
+	return Stage8LimiterReason(0,0,0);
+}
