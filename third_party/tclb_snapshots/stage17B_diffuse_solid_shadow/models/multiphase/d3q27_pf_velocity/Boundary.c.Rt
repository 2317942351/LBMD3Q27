CudaDeviceFunction void stage17b_keep_diffuse_shadow()
{
	PsiSolid = PsiSolid(0,0,0);
	PsiGradMag = PsiGradMag(0,0,0);
	PsiNormalX = PsiNormalX(0,0,0);
	PsiNormalY = PsiNormalY(0,0,0);
	PsiNormalZ = PsiNormalZ(0,0,0);
	PsiWallGhostRaw = PsiWallGhostRaw(0,0,0);
	PsiWallGhost = PsiWallGhost(0,0,0);
	PsiWallGhostClampHit = PsiWallGhostClampHit(0,0,0);
	PsiThetaImplied = PsiThetaImplied(0,0,0);
	PsiJaggedness = PsiJaggedness(0,0,0);
	PsiWriteAllowedFlag = PsiWriteAllowedFlag(0,0,0);
	PsiNormalAmbiguityFlag = PsiNormalAmbiguityFlag(0,0,0);
	PsiWriteAppliedFlag = PsiWriteAppliedFlag(0,0,0);
	PsiWriteRejectedReason = PsiWriteRejectedReason(0,0,0);
}

CudaDeviceFunction int stage17b_controlled_write_requested()
{
	return (Stage17BDiffuseSolidMode > 0.5 &&
	        Stage17BWriteMode > 1.5 &&
	        AnalyticWetting > 0.5 &&
	        AnalyticSolidType >= 1.5);
}

CudaDeviceFunction void stage17b_compute_diffuse_shadow(
	vector_t n_out, real_t signed_distance, real_t h0, real_t phi_f,
	vector_t grad_phi, real_t theta)
{
	stage17b_reset_diffuse_shadow();
	if (Stage17BDiffuseSolidMode < 0.5) {
		PsiWriteRejectedReason = 1.0;
		return;
	}
	if (AnalyticWetting < 0.5 || AnalyticSolidType < 1.5) {
		PsiWriteRejectedReason = 2.0;
		return;
	}
	PsiSolid = stage17b_diffuse_solid_indicator(signed_distance);
	vector_t grad_psi = stage17b_diffuse_solid_grad_analytic(n_out, signed_distance);
	real_t gmag = sqrt(grad_psi.x*grad_psi.x + grad_psi.y*grad_psi.y + grad_psi.z*grad_psi.z);
	PsiGradMag = gmag;
	if (gmag <= Stage17BGradPsiMin) {
		PsiNormalAmbiguityFlag = 1.0;
		PsiWriteRejectedReason = 4.0;
		return;
	}
	// psi_s is one in solid and zero in fluid; grad(psi_s) points inward.
	// Export the Stage17B convention solid -> fluid.
	vector_t n_s;
	n_s.x = -grad_psi.x / gmag;
	n_s.y = -grad_psi.y / gmag;
	n_s.z = -grad_psi.z / gmag;
	PsiNormalX = n_s.x;
	PsiNormalY = n_s.y;
	PsiNormalZ = n_s.z;
	real_t align = n_s.x*n_out.x + n_s.y*n_out.y + n_s.z*n_out.z;
	PsiJaggedness = fabs(1.0 - align);
	real_t clamp_hit = 0.0;
	real_t theta_shadow = theta;
	if (Stage17BShadowThetaDeg >= 0.0) {
		theta_shadow = Stage17BShadowThetaDeg * PI / 180.0;
	}
	real_t raw = stage13_compute_geometric_tangent_raw(n_s, h0, phi_f, grad_phi, theta_shadow);
	PsiWallGhostRaw = raw;
	PsiWallGhost = stage13_clamp_phase_value(raw, &clamp_hit);
	PsiWallGhostClampHit = clamp_hit;
	PsiThetaImplied = theta_shadow * 180.0 / PI;
	real_t dist = fabs(signed_distance);
	int shadow_ready = (dist <= Stage17BWriteBand &&
	                    gmag > Stage17BGradPsiMin &&
	                    PsiJaggedness < 1.0e-3 &&
	                    stage13_boundary_phase_is_valid(phi_f));
	PsiWriteAllowedFlag = shadow_ready ? 1.0 : 0.0;
	if (dist > Stage17BWriteBand) {
		PsiWriteRejectedReason = 3.0;
	} else if (PsiJaggedness >= 1.0e-3) {
		PsiWriteRejectedReason = 5.0;
	} else if (!stage13_boundary_phase_is_valid(phi_f)) {
		PsiWriteRejectedReason = 6.0;
	} else if (PsiWallGhost < PhaseField_l || PsiWallGhost > PhaseField_h) {
		PsiWriteRejectedReason = 7.0;
	} else if (Stage17BWriteMode < 1.5) {
		PsiWriteRejectedReason = 8.0;
	} else {
		PsiWriteRejectedReason = 0.0;
	}
}

CudaDeviceFunction void stage13_compute_compact_stencil_solution(
	vector_t n_w, real_t d_to_surface, real_t phi_f, real_t theta)
{
	stage13_reset_wall_csq();
	WallCSQMode = WallCompactStencilMode;
	WallCSQNormalMode = WallCompactStencilNormalMode;
	WallCSQThetaDeg = theta * 180.0 / PI;
	WallCSQNormalX = n_w.x;
	WallCSQNormalY = n_w.y;
	WallCSQNormalZ = n_w.z;
	WallCSQWriteAllowedFlag = WallCompactStencilWriteAllowedFlag;
	if (WallCompactStencilMode < 0.5) {
		WallCSQFallbackReason = 1.0;  // mode off
		return;
	}
	if (!stage13_compact_normal_mode_allows_write()) {
		WallCSQFallbackReason = 11.0;  // unsupported normal mode
		return;
	}
	real_t range = PhaseField_h - PhaseField_l;
	if (fabs(range) < 1.0e-30 || IntWidth <= 1.0e-30) {
		WallCSQFallbackReason = 2.0;  // invalid normalization or interface width
		return;
	}
	int first_probe_valid = stage13_boundary_phase_is_valid(phi_f);
	if (!first_probe_valid) {
		WallCSQFallbackReason = 3.0;  // no valid first fluid probe
	}
	real_t d_s = d_to_surface;
	if (d_s < 0.0) d_s = -d_s;
	if (d_s < 0.0) d_s = 0.0;

	real_t q_f = 0.5;
	real_t d_f = 0.0;
	if (stage13_find_compact_qf(n_w, d_s, &q_f, &d_f)) {
		WallCSQFallbackReason = 0.0;
		stage13_fill_compact_stencil_solution(q_f, d_s, d_f, theta, 1.0);
	} else {
		real_t fallback_reason = WallCSQFallbackReason;
		if (!first_probe_valid) {
			WallCSQFallbackReason = fallback_reason;
			return;
		}
		real_t q_probe = stage13_phase_to_q(phi_f);
		real_t d_probe = 1.0 - d_s;
		if (d_probe <= 1.0e-6) d_probe = 1.0;
		WallCSQStencilCase = 1.0;  // incomplete first-ring normal probe fallback
		WallCSQStencilL = 1.0;
		WallCSQFluidVertexCount = 1.0;
		WallCSQTriangleInside = 0.0;
		WallCSQPlaneId = 0.0;
		WallCSQBaryMin = 1.0;
		WallCSQBaryMax = 1.0;
		stage13_fill_compact_stencil_solution(q_probe, d_s, d_probe, theta, 0.0);
		WallCSQFallbackReason = fallback_reason;
	}
}

// Public accessor: the analytic wall normal at this node (zero if not analytic).
CudaDeviceFunction vector_t getAnalyticWallNormal() {
	if (AnalyticFlag(0,0,0) < 0.5) {
		vector_t zero = {0.0, 0.0, 0.0};
		return zero;
	}
	real_t h;
	return stage9_analytic_wall_normal_and_distance(&h);
}
