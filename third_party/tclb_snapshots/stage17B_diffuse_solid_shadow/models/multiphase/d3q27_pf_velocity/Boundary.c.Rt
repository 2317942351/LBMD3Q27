{
	PsiSolid = 0.0;
	PsiGradMag = 0.0;
	PsiNormalX = 0.0;
	PsiNormalY = 0.0;
	PsiNormalZ = 0.0;
	PsiWallGhostRaw = 0.0;
	PsiWallGhost = 0.0;
	PsiWallGhostClampHit = 0.0;
	PsiThetaImplied = 0.0;
	PsiJaggedness = 0.0;
	PsiWriteAllowedFlag = 0.0;
	PsiNormalAmbiguityFlag = 0.0;
	PsiWriteAppliedFlag = 0.0;
	PsiWriteRejectedReason = 0.0;
}

