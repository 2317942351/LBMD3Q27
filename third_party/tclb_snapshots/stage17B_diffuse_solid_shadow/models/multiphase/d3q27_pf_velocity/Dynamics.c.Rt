CudaDeviceFunction real_t stage14_max_abs2(real_t a, real_t b) {
	real_t aa = fabs(a);
	real_t bb = fabs(b);
	return (aa > bb) ? aa : bb;
}

CudaDeviceFunction real_t stage14_cancellation_ratio(real_t sum_abs, real_t sum_value) {
	real_t denom = fabs(sum_value);
	if (denom < 1.0e-30) denom = 1.0e-30;
	return sum_abs / denom;
}

CudaDeviceFunction int stage14_force_iter_limit_from_mode() {
	if (ForceFixedPointMode > 1.5 && ForceFixedPointMode < 2.5) {
		return 1;
	}
	if (ForceFixedPointMode > 0.5 && ForceFixedPointMode < 1.5) {
		int limit = ForceFixedMaxIter;
		if (limit < 1) limit = 1;
		return limit;
	}
	int limit = force_fixed_iterator;
	if (ForceFixedTol > 0.0) {
		limit = ForceFixedMaxIter;
	}
	if (limit < 1) limit = 1;
	return limit;
}

