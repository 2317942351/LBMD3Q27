CudaDeviceFunction real_t getDynamicCLCosResidual(){ return DynamicCLCosResidual(0,0,0); }
CudaDeviceFunction real_t getDynamicCLForceCandidateX(){ return DynamicCLForceCandidateX(0,0,0); }
