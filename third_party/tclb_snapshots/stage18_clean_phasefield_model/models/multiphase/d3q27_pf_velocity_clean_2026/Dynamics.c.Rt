CudaDeviceFunction real_t getRho(){
	if ( IamWall || IamSolid) {
		return 0.0;
	} else {
		real_t current_phase = PhaseF(0,0,0);
		return stage18_rho_from_phase(current_phase);
	}
}

CudaDeviceFunction real_t getPhaseField(){
	real_t current_phase = PhaseF(0,0,0);
	return current_phase;
}

CudaDeviceFunction real_t getPhaseFValid(){
	real_t current_phase = PhaseF(0,0,0);
	return (isfinite(current_phase) && current_phase >= PhaseField_l && current_phase <= PhaseField_h) ? 1.0 : 0.0;
}

CudaDeviceFunction real_t getPhaseOutOfBoundsFlag(){
	return 1.0 - getPhaseFValid();
}

CudaDeviceFunction vector_t getU(){
	vector_t u;
	if ( IamWall || IamSolid ) {
		u.x = 0.0; u.y = 0.0; u.z = 0.0;
	} else {
		u.x = U(0,0,0); u.y = V(0,0,0); u.z = W(0,0,0);
		if (!isfinite(u.x)) u.x = 0.0;
		if (!isfinite(u.y)) u.y = 0.0;
		if (!isfinite(u.z)) u.z = 0.0;
	}
	return u;
}

CudaDeviceFunction real_t getPstar(){
	real_t p = PressureMoment(0,0,0);
	return isfinite(p) ? p : 0.0;
}

CudaDeviceFunction real_t getP(){
	real_t p = PhysicalPressure(0,0,0);
	return isfinite(p) ? p : 0.0;
}

CudaDeviceFunction vector_t getNormal(){
	vector_t n = {SolidNormalX(0,0,0), SolidNormalY(0,0,0), SolidNormalZ(0,0,0)};
	if (!isfinite(n.x)) n.x = 0.0;
	if (!isfinite(n.y)) n.y = 0.0;
	if (!isfinite(n.z)) n.z = 0.0;
	return n;
}

CudaDeviceFunction vector_t getGradPhi(){
	vector_t gphi = {gradPhiVal_x(0,0,0), gradPhiVal_y(0,0,0), gradPhiVal_z(0,0,0)};
	if (!isfinite(gphi.x)) gphi.x = 0.0;
	if (!isfinite(gphi.y)) gphi.y = 0.0;
	if (!isfinite(gphi.z)) gphi.z = 0.0;
	return gphi;
}

CudaDeviceFunction vector_t getForceTotal(){
	vector_t f = {F_total_x(0,0,0), F_total_y(0,0,0), F_total_z(0,0,0)};
