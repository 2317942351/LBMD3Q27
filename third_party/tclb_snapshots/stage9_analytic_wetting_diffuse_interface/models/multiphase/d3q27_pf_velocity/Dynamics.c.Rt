CudaDeviceFunction void stage14_apply_momentum_force_mode(
	real_t F_total[3],
	real_t F_surf[3],
	real_t F_pressure[3],
	real_t F_body[3],
	real_t F_mu[3])
{
	if (MomentumForceMode > 0.5 && MomentumForceMode < 1.5) {
		F_total[0] -= F_mu[0];
		F_total[1] -= F_mu[1];
		F_total[2] -= F_mu[2];
	} else if (MomentumForceMode > 1.5 && MomentumForceMode < 2.5) {
		F_total[0] -= F_pressure[0];
		F_total[1] -= F_pressure[1];
		F_total[2] -= F_pressure[2];
	} else if (MomentumForceMode > 2.5 && MomentumForceMode < 3.5) {
		F_total[0] -= F_surf[0];
		F_total[1] -= F_surf[1];
		F_total[2] -= F_surf[2];
	} else if (MomentumForceMode > 3.5 && MomentumForceMode < 4.5) {
		F_total[0] = 0.0;
		F_total[1] = 0.0;
		F_total[2] = 0.0;
	} else if (MomentumForceMode > 4.5 && MomentumForceMode < 5.5) {
		F_total[0] = F_surf[0] + F_body[0];
		F_total[1] = F_surf[1] + F_body[1];
		F_total[2] = F_surf[2] + F_body[2];
	}
}

CudaDeviceFunction real_t stage14_pressure_force_input(real_t pressure_moment, real_t rho) {
	if (PressureClosureMode > 0.5 && PressureClosureMode < 1.5) {
		return pressure_moment * rho * cs2;
	}
	if (PressureClosureMode > 1.5 && PressureClosureMode < 2.5) {
		return pressure_moment - PressureClosureReference;
	}
	return pressure_moment;
}

CudaDeviceFunction real_t stage14_effective_force_rho(real_t rho) {
	real_t rho_eff = rho;
	if (ForceDensityClosureMode > 0.5 && ForceDensityClosureMode < 1.5) {
		real_t rho_floor = ForceDensityRhoFloor;
		if (rho_floor <= 0.0) rho_floor = Density_l;
		if (rho_floor < 1.0e-30) rho_floor = 1.0e-30;
		if (rho_eff < rho_floor) rho_eff = rho_floor;
	}
	return rho_eff;
}

CudaDeviceFunction real_t stage14_inv_force_rho(real_t rho) {
	real_t rho_eff = stage14_effective_force_rho(rho);
	return 1.0 / rho_eff;
}

CudaDeviceFunction real_t stage14_max_abs2(real_t a, real_t b) {
	real_t aa = fabs(a);
	real_t bb = fabs(b);
	return (aa > bb) ? aa : bb;
}

CudaDeviceFunction int stage14_force_iter_limit_from_mode() {
	if (ForceFixedPointMode > 1.5 && ForceFixedPointMode < 2.5) {
		return 1;
	}
	if (ForceFixedPointMode > 0.5 && ForceFixedPointMode < 1.5) {
		int limit = ForceFixedMaxIter;
		if (limit < 1) limit = 1;
		return limit;
	}
	int limit = force_fixed_iterator;
	if (ForceFixedTol > 0.0) {
		limit = ForceFixedMaxIter;
	}
	if (limit < 1) limit = 1;
	return limit;
}

