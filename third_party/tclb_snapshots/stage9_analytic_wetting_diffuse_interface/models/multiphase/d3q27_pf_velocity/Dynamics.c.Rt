CudaDeviceFunction int stage16_replay_diagnostics_active(){
	return (ReplayDiagnosticsMode > 0.5 && !(IamWall || IamSolid));
}

CudaDeviceFunction int stage14_momentum_closure_diagnostics_active(){
	return (stage16_replay_diagnostics_active() && MomentumClosureDiagnosticsMode > 0.5);
}

