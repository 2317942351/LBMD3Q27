+CudaDeviceFunction void stage8eNormalResidualCandidate() {
+	stage8ResetGradientDiagnostics();
+	real_t mode = Stage8OperatorMode;
+	if (mode < 0.5) {
+		return;
+	}
+	if (mode > 2.5) {
+		Stage8LimiterReason = 256.0;
+		return;
+	}
