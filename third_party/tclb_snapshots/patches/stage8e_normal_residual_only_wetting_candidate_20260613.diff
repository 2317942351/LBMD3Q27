+		normal_agreement = geom_normal.x*topo_normal.x + geom_normal.y*topo_normal.y + geom_normal.z*topo_normal.z;
+		if (normal_agreement < 0.0) {
+			geom_normal.x *= -1.0;
+			geom_normal.y *= -1.0;
+			geom_normal.z *= -1.0;
+			normal_agreement *= -1.0;
+		}
+		if (Stage8UseWallGeomNormal > 0.5 && normal_agreement >= Stage8NormalDotMin) {
+			wall_normal = geom_normal;
+			Stage8UsedGeomNormal = 1.0;
+		} else if (Stage8UseWallGeomNormal > 0.5) {
+			reason += 64.0;
+		}
+	}
+	Stage8NormalAgreement = normal_agreement;
+	Stage8FluidWallAngle = local_angle;
+	Stage8FluidWallNormal_x = wall_normal.x;
+	Stage8FluidWallNormal_y = wall_normal.y;
+	Stage8FluidWallNormal_z = wall_normal.z;
