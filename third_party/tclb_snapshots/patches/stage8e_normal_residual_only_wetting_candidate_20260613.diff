+	Stage8VectorDeltaRawMag = fabs(dn_try);
+	Stage8VectorDeltaLimitedMag = fabs(dn_limited);
+	if (fabs(dn_limited - dn_try) > 1e-10) {
+		Stage8NormalLimiterHit = 1.0;
+		Stage8LimiterReason += 128.0;
+	}
+	if (fabs(dn_try) > 1e-12) {
+		Stage8LimiterRatio = fabs(dn_limited/dn_try);
+	}
