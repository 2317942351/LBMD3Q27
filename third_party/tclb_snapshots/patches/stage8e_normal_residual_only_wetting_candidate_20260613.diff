+	Stage8FluidWallDataCount = local_count;
+	if (Stage8UseLocalWallAngle > 0.5 && local_count < 0.5) {
+		reason += 32.0;
+	}
+	if (Stage8UseWallGeomNormal > 0.5 && local_count < 0.5) {
+		reason += 32.0;
+	}
+	if (Stage8UseLocalWallAngle < 0.5) {
+		local_angle = radAngle;
+	}
