+		corrected.z = grad.z + dn_limited*wall_normal.z;
+		delta_mag = fabs(dn_limited);
+		Stage8VectorLimiterHit = 1.0;
+		Stage8LimiterReason += 1024.0;
+		Stage8NormalDeltaLimited = dn_limited;
+		Stage8VectorDeltaLimitedMag = delta_mag;
+		if (fabs(dn_try) > 1e-12) {
+			Stage8LimiterRatio = fabs(dn_limited/dn_try);
+		}
+	}
+
+	Stage8GradWriteDeltaMag = delta_mag;
+	Stage8GradCandidate_x = corrected.x;
+	Stage8GradCandidate_y = corrected.y;
+	Stage8GradCandidate_z = corrected.z;
+	Stage8GradCandidateUse = 1.0;
+
+	if (mode > 1.5 && mode < 2.5) {
+		gradPhiVal_x = corrected.x;
+		gradPhiVal_y = corrected.y;
+		gradPhiVal_z = corrected.z;
+	}
+}
+
+CudaDeviceFunction void stage8ApplyFluidGradientWetting() {
+	if (Stage8CandidateVersion >= 8.5) {
+		stage8eNormalResidualCandidate();
+	} else {
+		stage8dVectorCandidate();
+	}
+}
