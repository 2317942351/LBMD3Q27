+	} else if (c < 0.30) {
+		Stage8ContactBandTag = 3.0;
+	} else if (c <= 0.70) {
+		Stage8ContactBandTag = 4.0;
+	} else if (c <= 0.90) {
+		Stage8ContactBandTag = 5.0;
+	} else if (c <= 0.95) {
+		Stage8ContactBandTag = 6.0;
+	} else {
