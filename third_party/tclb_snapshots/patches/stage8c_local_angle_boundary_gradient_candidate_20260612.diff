+						Stage8LocalWallNormal_z_dyn(dx, dy, dz)
+					};
+					real_t local_mag = wallStage7VectorMag(local_normal);
+					if (local_mag > 1e-12) {
+						real_t dist = sqrt(1.0*dx*dx + 1.0*dy*dy + 1.0*dz*dz);
+						real_t w = 1.0/(dist + 1e-12);
+						normal.x += w*local_normal.x/local_mag;
+						normal.y += w*local_normal.y/local_mag;
+						normal.z += w*local_normal.z/local_mag;
+						angle_sum += w*Stage8LocalWallAngle_dyn(dx, dy, dz);
+						weight_sum += w;
+						*count += 1.0;
+					}
+				}
+			}
+		}
+	}
+	if (weight_sum > 1e-12) {
+		*angle = angle_sum/weight_sum;
+	}
+	return stage8UnitVector(normal);
+}
