+CudaDeviceFunction vector_t stage8GatherLocalWallNormal(real_t *angle, real_t *count) {
+	vector_t normal = {0.0, 0.0, 0.0};
+	real_t angle_sum = 0.0;
+	real_t weight_sum = 0.0;
+	*count = 0.0;
+	for (int dx=-1; dx<=1; dx++) {
