+CudaDeviceFunction real_t stage8gEffectiveTanCoeff(real_t tan_raw) {
+	real_t mode = Stage8gMode;
+	Stage8gTanRaw = tan_raw;
+	Stage8gTanEff = tan_raw;
+	Stage8gRegularizationRatio = 1.0;
+	if ((mode > 1.5 && mode < 2.5) || mode > 2.5) {
+		real_t tan_cap = fabs(Stage8gTanCap);
+		if (tan_cap > 1e-12) {
+			real_t scaled = tan_raw/tan_cap;
+			real_t tan_eff = tan_raw/sqrt(1.0 + scaled*scaled);
+			Stage8gTanEff = tan_eff;
+			if (fabs(tan_raw) > 1e-12) {
+				Stage8gRegularizationRatio = tan_eff/tan_raw;
+			}
+			return tan_eff;
+		}
+	}
+	return tan_raw;
+}
