+CudaDeviceFunction real_t stage8gProfileNormalGradient(vector_t wall_normal, real_t *sample_count) {
+	real_t weighted_sum = 0.0;
+	real_t weight_sum = 0.0;
+	*sample_count = 0.0;
+	for (int dx=-1; dx<=1; dx++) {
+		for (int dy=-1; dy<=1; dy++) {
+			for (int dz=-1; dz<=1; dz++) {
+				if (dx == 0 && dy == 0 && dz == 0) {
+					continue;
+				}
+				if (IsBoundary_dyn(dx, dy, dz) > 0.5) {
+					real_t dist = sqrt(1.0*dx*dx + 1.0*dy*dy + 1.0*dz*dz);
+					if (dist < 1e-12) {
+						continue;
+					}
+					real_t projection = -(dx*wall_normal.x + dy*wall_normal.y + dz*wall_normal.z)/dist;
+					if (projection <= 1e-6) {
+						continue;
+					}
+					real_t profile_grad = (PhaseF(0,0,0) - PhaseF_dyn(dx, dy, dz))/(dist + 1e-12);
+					real_t weight = projection/(dist + 1e-12);
+					weighted_sum += weight*profile_grad;
+					weight_sum += weight;
+					*sample_count += 1.0;
+				}
+			}
+		}
+	}
+	if (weight_sum > 1e-12) {
+		return weighted_sum/weight_sum;
+	}
+	return 0.0;
+}
