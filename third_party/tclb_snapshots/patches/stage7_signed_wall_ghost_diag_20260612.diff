+CudaDeviceFunction real_t wallDiagFluidSampleCount() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	real_t count = 0.0;
+	for (int dx = -2; dx <= 2; dx++) {
+		for (int dy = -2; dy <= 2; dy++) {
+			for (int dz = -2; dz <= 2; dz++) {
+				if (wallDiagUsableFluidSample(dx, dy, dz)) {
+					count += 1.0;
+				}
+			}
+		}
+	}
+	return count;
+}
+
+CudaDeviceFunction real_t wallDiagFluidSampleH() {
+	real_t h = 0.5 * sqrt(nw_x*nw_x + nw_y*nw_y + nw_z*nw_z);
+	if (!(IamWall || IamSolid)) {
+		return h;
+	}
+	real_t min_dist = 1e9;
+	for (int dx = -2; dx <= 2; dx++) {
+		for (int dy = -2; dy <= 2; dy++) {
+			for (int dz = -2; dz <= 2; dz++) {
+				if (wallDiagUsableFluidSample(dx, dy, dz)) {
+					real_t dist = sqrt((real_t)(dx*dx + dy*dy + dz*dz));
+					if (dist < min_dist) {
+						min_dist = dist;
+					}
+				}
+			}
+		}
+	}
+	if (min_dist < 1e8) {
+		return 0.5 * min_dist;
+	}
+	return h;
+}
+
+CudaDeviceFunction real_t wallDiagFluidSamplePfF() {
+	if (!(IamWall || IamSolid)) {
+		return PhaseF(0,0,0);
+	}
+	real_t weighted_sum = 0.0;
+	real_t weight_sum = 0.0;
+	for (int dx = -2; dx <= 2; dx++) {
+		for (int dy = -2; dy <= 2; dy++) {
+			for (int dz = -2; dz <= 2; dz++) {
+				if (wallDiagUsableFluidSample(dx, dy, dz)) {
+					real_t dist = sqrt((real_t)(dx*dx + dy*dy + dz*dz));
+					real_t weight = 1.0 / (dist + 1e-12);
+					weighted_sum += weight * PhaseF_dyn(dx, dy, dz);
+					weight_sum += weight;
+				}
+			}
+		}
+	}
+	if (weight_sum > 0.0) {
+		return weighted_sum / weight_sum;
+	}
+	return wallDiagRawPfF();
+}
+
+CudaDeviceFunction real_t wallDiagUnifiedProfilePhaseValue() {
+	if (!(IamWall || IamSolid)) {
+		return PhaseF(0,0,0);
+	}
+	if (IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_NEXT_NODE ?>) {
+		return wallDiagProfilePhaseValue(wallDiagFluidSamplePfF(), wallDiagFluidSampleH());
+	}
+	real_t h = 0.5 * sqrt(nw_x*nw_x + nw_y*nw_y + nw_z*nw_z);
+	return wallDiagProfilePhaseValue(wallDiagRawPfF(), h);
+}
