+CudaDeviceFunction vector_t wallStage7InterfaceGradient() {
+	if (!wallDiagIsNormalPath()) {
+		return wallDiagZeroVector();
+	}
+	return getWallGrad1();
+}
+
+CudaDeviceFunction real_t wallStage7VectorMag(vector_t vec) {
+	return sqrt(vec.x*vec.x + vec.y*vec.y + vec.z*vec.z);
+}
+
+CudaDeviceFunction real_t getWallSignedNormalGrad() {
+	if (!wallDiagIsNormalPath()) {
+		return 0.0;
+	}
+	vector_t grad = wallStage7InterfaceGradient();
+	vector_t wall_normal = wallStage7UnitWallNormal();
+	return grad.x*wall_normal.x + grad.y*wall_normal.y + grad.z*wall_normal.z;
+}
