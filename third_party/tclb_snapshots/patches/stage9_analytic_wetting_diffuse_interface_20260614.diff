+		// ----------------------------------------------------------
+		if (AnalyticFlag(0,0,0) > 0.5) {
+			real_t h = WallH(0,0,0);
+			if (h < 0.001) {
+				// Surrounded by solid (degenerate): keep physical bound.
+				WallGhost = PhaseField_h;
