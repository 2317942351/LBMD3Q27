 CudaDeviceFunction void calcWallPhase(){
 	PhaseF = PhaseF(0,0,0); //For fluid nodes.
 	if ( IamWall || IamSolid ) {
+		// ----------------------------------------------------------
+		// Stage9 analytic-geometry diffuse-interface wetting BC.
+		// If this wall node was flagged analytic during Init_wallNorm,
+		// compute the wall ghost from the analytic normal (already stored
+		// in nw_*) and the fluid-side phase/gradient read along nw.
+		// Result goes into the dedicated WallGhost field, and PhaseF on
+		// this wall node is set to the mirrored fluid value (NOT -999)
