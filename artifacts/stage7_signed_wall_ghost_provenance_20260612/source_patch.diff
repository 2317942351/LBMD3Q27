@@ -530,6 +530,610 @@ CudaDeviceFunction vector_t getGradPhi() {
 	return gradPhi;
 }
 
+
+CudaDeviceFunction real_t wallDiagRawPfF() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	return gradPhi_PhaseF_dyn(nw_x, nw_y, nw_z);
+}
+
+CudaDeviceFunction real_t getWallPfF() {
+	return wallDiagRawPfF();
+}
+
+CudaDeviceFunction real_t getWallTanCoeff() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	return tan(PI/2.0 - radAngle);
+}
+
+CudaDeviceFunction real_t getWallBCPath() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+
+	real_t h = 0.5 * sqrt(nw_x*nw_x + nw_y*nw_y + nw_z*nw_z);
+	if (h < 0.001) {
+		return 1.0;
+	}
+	if (fabs(radAngle - PI/2.0) < 1e-4) {
+		return 2.0;
+	}
+	if (IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_NEXT_NODE ?>) {
+		return 3.0;
+	}
+	if (IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_FURTHER_NEXT_NODE ?>) {
+		return 4.0;
+	}
+	return 5.0;
+}
+
+CudaDeviceFunction vector_t wallDiagZeroVector() {
+	vector_t out = {0.0, 0.0, 0.0};
+	return out;
+}
+
+CudaDeviceFunction bool wallDiagIsNormalPath() {
+	return getWallBCPath() == 5.0;
+}
+
+CudaDeviceFunction real_t getWallH() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	return 0.5 * sqrt(nw_x*nw_x + nw_y*nw_y + nw_z*nw_z);
+}
+
+CudaDeviceFunction vector_t getWallGeomNormal() {
+	if (!(IamWall || IamSolid)) {
+		return wallDiagZeroVector();
+	}
+	vector_t solid_normal = {nw_x, nw_y, nw_z};
+	return solid_normal;
+}
+
+CudaDeviceFunction vector_t getWallGrad1() {
+	if (!wallDiagIsNormalPath()) {
+		return wallDiagZeroVector();
+	}
+#ifdef OPTIONS_staircaseimp
+	return wallDiagZeroVector();
+#else
+	vector_t grad_1 = {
+		gradPhiVal_x_dyn(nw_x, nw_y, nw_z),
+		gradPhiVal_y_dyn(nw_x, nw_y, nw_z),
+		gradPhiVal_z_dyn(nw_x, nw_y, nw_z)
+	};
+	return grad_1;
+#endif
+}
+
+CudaDeviceFunction vector_t getWallGrad2() {
+	if (!wallDiagIsNormalPath()) {
+		return wallDiagZeroVector();
+	}
+#ifdef OPTIONS_staircaseimp
+	return wallDiagZeroVector();
+#else
+	vector_t grad_2 = {
+		gradPhiVal_x_dyn(2*nw_x, 2*nw_y, 2*nw_z),
+		gradPhiVal_y_dyn(2*nw_x, 2*nw_y, 2*nw_z),
+		gradPhiVal_z_dyn(2*nw_x, 2*nw_y, 2*nw_z)
+	};
+	return grad_2;
+#endif
+}
+
+CudaDeviceFunction real_t wallDiagNormalCoeff(vector_t grad) {
+	vector_t solid_normal = getWallGeomNormal();
+	real_t norm = solid_normal.x*solid_normal.x + solid_normal.y*solid_normal.y + solid_normal.z*solid_normal.z;
+	if (norm < 1e-12) {
+		return 0.0;
+	}
+	return (grad.x*solid_normal.x + grad.y*solid_normal.y + grad.z*solid_normal.z)/norm;
+}
+
+CudaDeviceFunction vector_t wallDiagProjectedTangent(vector_t grad) {
+	vector_t solid_normal = getWallGeomNormal();
+	real_t coeff = wallDiagNormalCoeff(grad);
+	vector_t proj = {
+		grad.x - coeff*solid_normal.x,
+		grad.y - coeff*solid_normal.y,
+		grad.z - coeff*solid_normal.z
+	};
+	return proj;
+}
+
+CudaDeviceFunction real_t getWallNormalCoeff1() {
+	if (!wallDiagIsNormalPath()) {
+		return 0.0;
+	}
+	return wallDiagNormalCoeff(getWallGrad1());
+}
+
+CudaDeviceFunction real_t getWallNormalCoeff2() {
+	if (!wallDiagIsNormalPath()) {
+		return 0.0;
+	}
+	return wallDiagNormalCoeff(getWallGrad2());
+}
+
+CudaDeviceFunction vector_t getWallGradTangentVec() {
+	if (!wallDiagIsNormalPath()) {
+		return wallDiagZeroVector();
+	}
+	vector_t proj_grad_1 = wallDiagProjectedTangent(getWallGrad1());
+	vector_t proj_grad_2 = wallDiagProjectedTangent(getWallGrad2());
+	vector_t grad_tangent_v = {
+		1.5*proj_grad_1.x - 0.5*proj_grad_2.x,
+		1.5*proj_grad_1.y - 0.5*proj_grad_2.y,
+		1.5*proj_grad_1.z - 0.5*proj_grad_2.z
+	};
+	return grad_tangent_v;
+}
+
+CudaDeviceFunction real_t getWallGradTangent() {
+	if (getWallBCPath() != 5.0) {
+		return 0.0;
+	}
+
+#ifdef OPTIONS_staircaseimp
+	// This diagnostic lane is built for q27_geometric without staircase improvement.
+	return 0.0;
+#else
+	vector_t solid_normal = {nw_x, nw_y, nw_z};
+	real_t der_x_1 = gradPhiVal_x_dyn(nw_x,   nw_y,   nw_z);
+	real_t der_y_1 = gradPhiVal_y_dyn(nw_x,   nw_y,   nw_z);
+	real_t der_z_1 = gradPhiVal_z_dyn(nw_x,   nw_y,   nw_z);
+	real_t der_x_2 = gradPhiVal_x_dyn(2*nw_x, 2*nw_y, 2*nw_z);
+	real_t der_y_2 = gradPhiVal_y_dyn(2*nw_x, 2*nw_y, 2*nw_z);
+	real_t der_z_2 = gradPhiVal_z_dyn(2*nw_x, 2*nw_y, 2*nw_z);
+
+	real_t norm = solid_normal.x*solid_normal.x + solid_normal.y*solid_normal.y + solid_normal.z*solid_normal.z;
+	if (norm < 1e-12) {
+		return 0.0;
+	}
+
+	real_t coeff_1 = (der_x_1*solid_normal.x + der_y_1*solid_normal.y + der_z_1*solid_normal.z)/norm;
+	real_t coeff_2 = (der_x_2*solid_normal.x + der_y_2*solid_normal.y + der_z_2*solid_normal.z)/norm;
+	vector_t proj_grad_1 = {der_x_1 - coeff_1*solid_normal.x, der_y_1 - coeff_1*solid_normal.y, der_z_1 - coeff_1*solid_normal.z};
+	vector_t proj_grad_2 = {der_x_2 - coeff_2*solid_normal.x, der_y_2 - coeff_2*solid_normal.y, der_z_2 - coeff_2*solid_normal.z};
+	vector_t grad_tangent_v = {1.5*proj_grad_1.x - 0.5*proj_grad_2.x,
+								 1.5*proj_grad_1.y - 0.5*proj_grad_2.y,
+								 1.5*proj_grad_1.z - 0.5*proj_grad_2.z};
+	return sqrt(grad_tangent_v.x*grad_tangent_v.x + grad_tangent_v.y*grad_tangent_v.y + grad_tangent_v.z*grad_tangent_v.z);
+#endif
+}
+
+CudaDeviceFunction real_t getWallPhasePred() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+
+	real_t h = 0.5 * sqrt(nw_x*nw_x + nw_y*nw_y + nw_z*nw_z);
+	real_t pf_f = wallDiagRawPfF();
+	if (h < 0.001) {
+		return 1.0;
+	}
+	if (fabs(radAngle - PI/2.0) < 1e-4) {
+		return pf_f;
+	}
+	if (IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_NEXT_NODE ?>) {
+		return PhaseF_dyn(nw_x, nw_y, nw_z);
+	}
+	if (IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_FURTHER_NEXT_NODE ?>) {
+		real_t a = -h * (4.0/IntWidth) * cos(radAngle);
+		return (1 + a - sqrt((1+a)*(1+a) - 4*a*pf_f))/(a+1e-12) - pf_f;
+	}
+	return getWallTanCoeff() * getWallGradTangent() * 2.0*h + pf_f;
+}
+
+CudaDeviceFunction real_t wallDiagProfilePhaseValue(real_t pf_f, real_t h) {
+	if (h < 0.001) {
+		return 1.0;
+	}
+	if (fabs(radAngle - PI/2.0) < 1e-4) {
+		return pf_f;
+	}
+	real_t a = -h * (4.0/IntWidth) * cos(radAngle);
+	return (1 + a - sqrt((1+a)*(1+a) - 4*a*pf_f))/(a+1e-12) - pf_f;
+}
+
+CudaDeviceFunction bool wallDiagUsableFluidSample(int dx, int dy, int dz) {
+	if (dx == 0 && dy == 0 && dz == 0) {
+		return false;
+	}
+	if (IsBoundary_dyn(dx, dy, dz) > 0.5) {
+		return false;
+	}
+	real_t pf = PhaseF_dyn(dx, dy, dz);
+	real_t phase_range = fabs(PhaseField_h - PhaseField_l);
+	return (pf > PhaseField_l - phase_range) && (pf < PhaseField_h + phase_range);
+}
+
+CudaDeviceFunction real_t wallDiagFluidSampleCount() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	real_t count = 0.0;
+	for (int dx = -2; dx <= 2; dx++) {
+		for (int dy = -2; dy <= 2; dy++) {
+			for (int dz = -2; dz <= 2; dz++) {
+				if (wallDiagUsableFluidSample(dx, dy, dz)) {
+					count += 1.0;
+				}
+			}
+		}
+	}
+	return count;
+}
+
+CudaDeviceFunction real_t wallDiagFluidSampleH() {
+	real_t h = 0.5 * sqrt(nw_x*nw_x + nw_y*nw_y + nw_z*nw_z);
+	if (!(IamWall || IamSolid)) {
+		return h;
+	}
+	real_t min_dist = 1e9;
+	for (int dx = -2; dx <= 2; dx++) {
+		for (int dy = -2; dy <= 2; dy++) {
+			for (int dz = -2; dz <= 2; dz++) {
+				if (wallDiagUsableFluidSample(dx, dy, dz)) {
+					real_t dist = sqrt((real_t)(dx*dx + dy*dy + dz*dz));
+					if (dist < min_dist) {
+						min_dist = dist;
+					}
+				}
+			}
+		}
+	}
+	if (min_dist < 1e8) {
+		return 0.5 * min_dist;
+	}
+	return h;
+}
+
+CudaDeviceFunction real_t wallDiagFluidSamplePfF() {
+	if (!(IamWall || IamSolid)) {
+		return PhaseF(0,0,0);
+	}
+	real_t weighted_sum = 0.0;
+	real_t weight_sum = 0.0;
+	for (int dx = -2; dx <= 2; dx++) {
+		for (int dy = -2; dy <= 2; dy++) {
+			for (int dz = -2; dz <= 2; dz++) {
+				if (wallDiagUsableFluidSample(dx, dy, dz)) {
+					real_t dist = sqrt((real_t)(dx*dx + dy*dy + dz*dz));
+					real_t weight = 1.0 / (dist + 1e-12);
+					weighted_sum += weight * PhaseF_dyn(dx, dy, dz);
+					weight_sum += weight;
+				}
+			}
+		}
+	}
+	if (weight_sum > 0.0) {
+		return weighted_sum / weight_sum;
+	}
+	return wallDiagRawPfF();
+}
+
+CudaDeviceFunction real_t wallDiagUnifiedProfilePhaseValue() {
+	if (!(IamWall || IamSolid)) {
+		return PhaseF(0,0,0);
+	}
+	if (IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_NEXT_NODE ?>) {
+		return wallDiagProfilePhaseValue(wallDiagFluidSamplePfF(), wallDiagFluidSampleH());
+	}
+	real_t h = 0.5 * sqrt(nw_x*nw_x + nw_y*nw_y + nw_z*nw_z);
+	return wallDiagProfilePhaseValue(wallDiagRawPfF(), h);
+}
+
+CudaDeviceFunction real_t getWallFluidSampleCount() {
+	return wallDiagFluidSampleCount();
+}
+
+CudaDeviceFunction real_t getWallFluidSampleH() {
+	return wallDiagFluidSampleH();
+}
+
+CudaDeviceFunction real_t getWallPhaseUnifiedProfilePred() {
+	return wallDiagUnifiedProfilePhaseValue();
+}
+
+CudaDeviceFunction real_t getWallUnifiedProfileDelta() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	return getWallPhasePred() - wallDiagUnifiedProfilePhaseValue();
+}
+
+CudaDeviceFunction real_t getWallActualMinusProfile() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	return PhaseF(0,0,0) - wallDiagUnifiedProfilePhaseValue();
+}
+
+CudaDeviceFunction real_t getWallActualMinusRaw() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	return PhaseF(0,0,0) - getWallPhasePred();
+}
+
+CudaDeviceFunction real_t wallDiagSignedLogitShift(real_t pf_f, real_t h) {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	if (h < 0.001 || fabs(radAngle - PI/2.0) < 1e-4) {
+		return 0.0;
+	}
+	real_t phase_range = PhaseField_h - PhaseField_l;
+	if (fabs(phase_range) < 1e-12) {
+		return 0.0;
+	}
+	real_t c = (pf_f - PhaseField_l) / phase_range;
+	real_t eps = 1e-12;
+	if (c < eps) {
+		c = eps;
+	}
+	if (c > 1.0 - eps) {
+		c = 1.0 - eps;
+	}
+	real_t raw_delta = getWallPhasePred() - pf_f;
+	return raw_delta / (phase_range * c * (1.0 - c));
+}
+
+CudaDeviceFunction real_t wallDiagSignedProfilePhaseValue(real_t pf_f, real_t h) {
+	if (h < 0.001) {
+		return PhaseField_h;
+	}
+	if (fabs(radAngle - PI/2.0) < 1e-4) {
+		return pf_f;
+	}
+	real_t phase_range = PhaseField_h - PhaseField_l;
+	if (fabs(phase_range) < 1e-12) {
+		return pf_f;
+	}
+	real_t c = (pf_f - PhaseField_l) / phase_range;
+	real_t eps = 1e-12;
+	if (c < eps) {
+		c = eps;
+	}
+	if (c > 1.0 - eps) {
+		c = 1.0 - eps;
+	}
+	real_t q = log(c / (1.0 - c)) + wallDiagSignedLogitShift(pf_f, h);
+	if (q > 60.0) {
+		q = 60.0;
+	}
+	if (q < -60.0) {
+		q = -60.0;
+	}
+	real_t c_wall = 1.0 / (1.0 + exp(-q));
+	return PhaseField_l + phase_range * c_wall;
+}
+
+CudaDeviceFunction real_t getWallPhaseProfilePred() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+
+	return wallDiagUnifiedProfilePhaseValue();
+}
+
+CudaDeviceFunction real_t getWallProfileDelta() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	return getWallPhasePred() - getWallPhaseProfilePred();
+}
+
+CudaDeviceFunction real_t getWallPhaseSignedProfilePred() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+
+	real_t h = 0.5 * sqrt(nw_x*nw_x + nw_y*nw_y + nw_z*nw_z);
+	real_t pf_f = wallDiagRawPfF();
+	if (IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_NEXT_NODE ?> ||
+		IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_FURTHER_NEXT_NODE ?>) {
+		return wallDiagUnifiedProfilePhaseValue();
+	}
+	return wallDiagSignedProfilePhaseValue(pf_f, h);
+}
+
+CudaDeviceFunction real_t getWallSignedProfileDelta() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+	return getWallPhasePred() - getWallPhaseSignedProfilePred();
+}
+
+CudaDeviceFunction real_t getWallSignedLogitShift() {
+	if (!(IamWall || IamSolid)) {
+		return 0.0;
+	}
+
+	real_t h = 0.5 * sqrt(nw_x*nw_x + nw_y*nw_y + nw_z*nw_z);
+	real_t pf_f = wallDiagRawPfF();
+	if (IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_NEXT_NODE ?> ||
+		IsSpecialBoundaryPoint == <?%d NORMAL_POINTING_INTO_SOLID_ON_FURTHER_NEXT_NODE ?>) {
+		return 0.0;
+	}
+	return wallDiagSignedLogitShift(pf_f, h);
+}
+
+CudaDeviceFunction real_t getWallPhaseRawPred() {
+	return getWallPhasePred();
+}
+
+CudaDeviceFunction real_t getBoundaryMask() {
+	if (IamWall || IamSolid) {
+		return 1.0;
+	}
+	if (IsBoundary(0,0,0) > 0.5) {
+		return 1.0;
+	}
+	return 0.0;
+}
+
+CudaDeviceFunction vector_t wallStage7UnitWallNormal() {
+	vector_t normal = getWallGeomNormal();
+	real_t mag = sqrt(normal.x*normal.x + normal.y*normal.y + normal.z*normal.z);
+	if (mag < 1e-12) {
+		return wallDiagZeroVector();
+	}
+	vector_t unit = {normal.x/mag, normal.y/mag, normal.z/mag};
+	return unit;
+}
+
+CudaDeviceFunction vector_t wallStage7InterfaceGradient() {
+	if (!wallDiagIsNormalPath()) {
+		return wallDiagZeroVector();
+	}
+	return getWallGrad1();
+}
+
+CudaDeviceFunction real_t wallStage7VectorMag(vector_t vec) {
+	return sqrt(vec.x*vec.x + vec.y*vec.y + vec.z*vec.z);
+}
+
+CudaDeviceFunction real_t getWallSignedNormalGrad() {
+	if (!wallDiagIsNormalPath()) {
+		return 0.0;
+	}
+	vector_t grad = wallStage7InterfaceGradient();
+	vector_t wall_normal = wallStage7UnitWallNormal();
+	return grad.x*wall_normal.x + grad.y*wall_normal.y + grad.z*wall_normal.z;
+}
+
+CudaDeviceFunction real_t getWallTangentGradMag() {
+	if (!wallDiagIsNormalPath()) {
+		return 0.0;
+	}
+	vector_t tangent = getWallGradTangentVec();
+	return wallStage7VectorMag(tangent);
+}
+
+CudaDeviceFunction real_t wallStage7TargetNormalGrad() {
+	if (!wallDiagIsNormalPath()) {
+		return 0.0;
+	}
+	return -getWallTanCoeff() * getWallTangentGradMag();
+}
+
+CudaDeviceFunction real_t getWallContactResidual() {
+	if (!wallDiagIsNormalPath()) {
+		return 0.0;
+	}
+	vector_t grad = wallStage7InterfaceGradient();
+	vector_t wall_normal = wallStage7UnitWallNormal();
+	real_t grad_mag = wallStage7VectorMag(grad);
+	if (grad_mag < minGradient) {
+		return 0.0;
+	}
+	real_t actual_cos = (grad.x*wall_normal.x + grad.y*wall_normal.y + grad.z*wall_normal.z) / grad_mag;
+	real_t target_cos = -cos(radAngle);
+	return actual_cos - target_cos;
+}
+
+CudaDeviceFunction real_t wallStage7SignedDeltaPhi(real_t h) {
+	return -2.0 * h * wallStage7TargetNormalGrad();
+}
+
+CudaDeviceFunction real_t wallStage7SignedDeltaQ(real_t pf_f, real_t h) {
+	real_t phase_range = PhaseField_h - PhaseField_l;
+	if (fabs(phase_range) < 1e-12) {
+		return 0.0;
+	}
+	real_t c = (pf_f - PhaseField_l) / phase_range;
+	real_t eps = 1e-12;
+	if (c < eps) {
+		c = eps;
+	}
+	if (c > 1.0 - eps) {
+		c = 1.0 - eps;
+	}
+	return wallStage7SignedDeltaPhi(h) / (phase_range * c * (1.0 - c));
+}
+
+CudaDeviceFunction real_t getWallSignedDeltaQ() {
+	if (!wallDiagIsNormalPath()) {
+		return 0.0;
+	}
+	return wallStage7SignedDeltaQ(wallDiagRawPfF(), getWallH());
+}
+
+CudaDeviceFunction real_t getWallSignedQClipped() {
+	if (!wallDiagIsNormalPath()) {
+		return 0.0;
+	}
+	real_t pf_f = wallDiagRawPfF();
+	real_t phase_range = PhaseField_h - PhaseField_l;
+	if (fabs(phase_range) < 1e-12) {
+		return 0.0;
+	}
+	real_t c = (pf_f - PhaseField_l) / phase_range;
+	real_t eps = 1e-12;
+	if (c < eps) {
+		c = eps;
+	}
+	if (c > 1.0 - eps) {
+		c = 1.0 - eps;
+	}
+	real_t q = log(c / (1.0 - c)) + wallStage7SignedDeltaQ(pf_f, getWallH());
+	if (q > 60.0 || q < -60.0) {
+		return 1.0;
+	}
+	return 0.0;
+}
+
+CudaDeviceFunction real_t wallStage7SignedWallGhostValue(real_t pf_f, real_t h) {
+	if (h < 0.001) {
+		return PhaseField_h;
+	}
+	if (fabs(radAngle - PI/2.0) < 1e-4) {
+		return pf_f;
+	}
+	real_t phase_range = PhaseField_h - PhaseField_l;
+	if (fabs(phase_range) < 1e-12) {
+		return pf_f;
+	}
+	real_t c = (pf_f - PhaseField_l) / phase_range;
+	real_t eps = 1e-12;
+	if (c < eps) {
+		c = eps;
+	}
+	if (c > 1.0 - eps) {
+		c = 1.0 - eps;
+	}
+	real_t q = log(c / (1.0 - c)) + wallStage7SignedDeltaQ(pf_f, h);
+	if (q > 60.0) {
